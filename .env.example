# Copy this file to .env and fill in your own keys. Never commit the real one.

ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Optional: only needed for the Spotify tools (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=

# Optional: microphone for the wake word. A number from `python list_audio.py`,
# part of the device's name, or leave blank for the system default.
MIC_DEVICE=
